{
  "schemaVersion": 1,
  "id": "myticclient",
  "version": "${version}",
  "name": "Mytic Client",
  "description": "In-Game-Mods des Mytic Client: FPS, CPS, Keystrokes, Koordinaten, Rüstung, Tränke, Ping, Zoom, Fullbright, Toggle Sprint und ein Mod-Menü (Rechts-Shift).",
  "authors": [
    "MyticLegacy"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/myticclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.myticlegacy.client.MyticClient"
    ]
  },
  "mixins": [
    "myticclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "${mc}",
    "java": ">=25"
  }
}